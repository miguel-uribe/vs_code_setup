{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script .ai/setup_env.py --agent-context"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --script .ai/setup_env.py:*)"
    ]
  }
}
